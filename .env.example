# Browser-facing API origin
NEXT_PUBLIC_API_URL=http://localhost:8000

# API settings
TALENTMATCH_ENV=development
TALENTMATCH_CORS_ORIGINS=http://localhost:3000
TALENTMATCH_MAX_TEXT_CHARACTERS=100000
TALENTMATCH_MAX_UPLOAD_BYTES=10485760
TALENTMATCH_MAX_PDF_PAGES=100
TALENTMATCH_DATABASE_URL=sqlite:///./talentmatch.db
TALENTMATCH_CREDENTIAL_SESSION_TTL_SECONDS=3600
TALENTMATCH_DIAGNOSTICS_ENABLED=false

# Self-hosted provider credentials (not used by the mock provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
